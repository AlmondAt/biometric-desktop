# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit the .env file to Git (it's in .gitignore)

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Application environment
NODE_ENV=development

# Server port for Express API
API_PORT=3001

# Python services port
PYTHON_PORT=5001

# ============================================
# RASPY INTEGRATION (if connecting to Raspy server)
# ============================================

# Raspy API endpoint
RASPY_API_URL=http://localhost:5000

# Raspy API authentication key
# Get this from your Raspy admin
RASPY_API_KEY=your_api_key_here

# Request timeout in milliseconds
RASPY_API_TIMEOUT=5000

# ============================================
# FACE RECOGNITION SETTINGS
# ============================================

# Which face recognition model to use
# Options: facenet, vggface2, arcface
EMBEDDING_MODEL=facenet

# Face recognition confidence threshold (0.0 - 1.0)
# Higher = more strict matching
FACE_THRESHOLD=0.5

# Minimum number of faces to detect in image
MIN_FACES=1

# ============================================
# DATABASE CONFIGURATION
# ============================================

# SQLite database file path
DB_PATH=./app.db

# Path to embeddings pickle file (trained face embeddings)
EMBEDDINGS_PATH=./embeddings.pkl

# ============================================
# LOGGING
# ============================================

# Log level: info, debug, warn, error
LOG_LEVEL=info

# Log output directory
LOG_DIR=./logs

# ============================================
# DEVELOPMENT SETTINGS (for debugging)
# ============================================

# Enable debug mode (more verbose logging)
DEBUG=false

# Enable hot reload for development
HOT_RELOAD=true

# Skip authentication in development
# WARNING: Only for local development, never in production!
SKIP_AUTH_DEV=false

# ============================================
# OPTIONAL: Advanced Settings
# ============================================

# Database connection pool size
DB_POOL_SIZE=5

# Request body size limit
REQUEST_SIZE_LIMIT=50mb

# CORS settings
CORS_ORIGIN=*

# ============================================
# NOTES
# ============================================

# 1. This file should NEVER be committed to Git
# 2. Copy this template to .env and fill in your values
# 3. Each developer should have their own .env file
# 4. For production, use environment variables from deployment platform
# 5. For CI/CD, use secrets in GitHub Actions or your CI/CD platform

# Example of setting environment variables in Windows PowerShell:
# $env:NODE_ENV = "production"
# $env:RASPY_API_KEY = "your_key"

# Example in Linux/macOS:
# export NODE_ENV=production
# export RASPY_API_KEY=your_key
